    },
    {
      "name": "Staged multi-party signing",
      "description": "Propose → each pending party signs its own auth entry (`signAuthEntry`, not `signTransaction`) → the proposer signs `ready_xdr` and submits it through `/transactions/submit` with `completeProposalId`. Poll the GET routes about every 10 seconds while waiting.",
      "item": [
        {
          "name": "Propose cancel",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/tx/cancel/propose",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "tx",
                "cancel",
                "propose"
              ]
            },
            "description": "Buyer or cooperative may propose. Idempotent: returns the already-active proposal if there is one. Saves `proposalId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposerPublicKey\": \"{{cooperative}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const value = body.id;",
                  "if (value) pm.collectionVariables.set(\"proposalId\", value);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get active cancel proposal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/tx/cancel/propose",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "tx",
                "cancel",
                "propose"
              ]
            },
            "description": "`{\"proposal\": ...}` or `{\"proposal\": null}`."
          }
        },
        {
          "name": "Propose reassign buyer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/tx/reassign-buyer/propose",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "tx",
                "reassign-buyer",
                "propose"
              ]
            },
            "description": "Only the current buyer may propose. Saves `proposalId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposerPublicKey\": \"{{buyer}}\",\n  \"newBuyer\": \"{{newBuyer}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const value = body.id;",
                  "if (value) pm.collectionVariables.set(\"proposalId\", value);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get active reassign-buyer proposal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/tx/reassign-buyer/propose",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "tx",
                "reassign-buyer",
                "propose"
              ]
            },
            "description": "`{\"proposal\": ...}` or `{\"proposal\": null}`."
          }
        },
        {
          "name": "Propose resolve dispute",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/tx/resolve-dispute/propose",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "tx",
                "resolve-dispute",
                "propose"
              ]
            },
            "description": "Buyer, cooperative or warehouse operator may propose; needs the other two parties' signatures. Saves `proposalId`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proposerPublicKey\": \"{{buyer}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const value = body.id;",
                  "if (value) pm.collectionVariables.set(\"proposalId\", value);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get active resolve-dispute proposal",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/tx/resolve-dispute/propose",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "tx",
                "resolve-dispute",
                "propose"
              ]
            },
            "description": "`{\"proposal\": ...}` or `{\"proposal\": null}`."
          }
        },
        {
          "name": "Sign proposal entry",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/tx/propose/{{proposalId}}/sign",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "tx",
                "propose",
                "{{proposalId}}",
                "sign"
              ]
            },
            "description": "Records one party's signed auth entry against any proposal. The proposal flips to `ready` (with `ready_xdr`) once every pending entry is signed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"signerPublicKey\": \"{{buyer}}\",\n  \"signedEntryXdr\": \"{{signedEntryXdr}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Allocation ledger",
      "description": "Per-member salted hashes on-chain; phone numbers only ever in Postgres.",
      "item": [
        {
          "name": "Build set-allocation XDR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/tx/set-allocation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "tx",
                "set-allocation"
              ]
            },
            "description": "Cooperative-gated, pre-`lock` only. Returns the unsigned XDR plus the staged members (salt and hash, not yet persisted). Pass those members back to Submit with `allocationContractId`/`allocationMembers` once signed.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"members\": [\n    {\n      \"phoneNumber\": \"+2348000000001\",\n      \"shareBps\": 6000\n    },\n    {\n      \"phoneNumber\": \"+2348000000002\",\n      \"shareBps\": 4000\n    }\n  ],\n  \"sourcePublicKey\": \"{{cooperative}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "if (body.xdr) pm.collectionVariables.set(\"unsignedXdr\", body.xdr);",
                  "if (body.members) pm.collectionVariables.set(\"stagedMembers\", JSON.stringify(body.members));",
                  "if (body.members && body.members[0]) pm.collectionVariables.set(\"memberHash\", body.members[0].memberHash);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get allocation",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/allocation",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "allocation"
              ]
            },
            "description": "Live on-chain read of member hashes and shares. Never returns a phone number."
          }
        },
        {
          "name": "Erase allocation member (NDPA s.34)",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/allocation-members/{{memberHash}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "allocation-members",
                "{{memberHash}}"
              ]
            },
            "description": "Nulls the phone number behind an on-chain hash. Idempotent."
          }
        }
      ]
    },
    {
      "name": "Oracle",
      "description": "PRD §16.3 oracle staleness bound.",
      "item": [
        {
          "name": "Get oracle config",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/oracle-config",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "oracle-config"
              ]
            },
            "description": "`{\"config\": null}` if `initialize` never set one, which is a valid state."
          }
        },
        {
          "name": "Get live oracle rate",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/oracle-rate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "oracle-rate"
              ]
            },
            "description": "Live cross-contract call to the configured oracle, never cached. 500 if no oracle is configured, the asset isn't quoted, or the quote is too old."
          }
        }
      ]
    },
    {
      "name": "Submit",
      "description": "Every write: build XDR → sign it with the party's own key → submit.",
      "item": [
        {
          "name": "Submit signed transaction",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/transactions/submit",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "transactions",
                "submit"
              ]
            },
            "description": "Submits a signed envelope and polls for confirmation. Optional fields: `refreshContractId` (refresh the Postgres cache), `completeProposalId` (finalize a staged proposal), `allocationContractId` + `allocationMembers` (persist a staged allocation). Remove the ones you don't need. Built transactions are time-bounded (60 s; 300 s for a finalized proposal), so sign and submit promptly.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"xdr\": \"{{signedXdr}}\",\n  \"refreshContractId\": \"{{contractId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
    },
    {
      "name": "Reads",
      "description": "Commitment state and party standing.",
      "item": [
        {
          "name": "Get commitment (live)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}"
              ]
            },
            "description": "Live read from chain (source of truth); refreshes the Postgres cache as a side effect."
          }
        },
        {
          "name": "List commitments (cached)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/commitments?limit=20&offset=0",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "20"
                },
                {
                  "key": "offset",
                  "value": "0"
                }
              ]
            },
            "description": "Postgres-cached list, newest first. Default page size 20, `limit` clamped to 100; unusable values fall back to the defaults."
          }
        },
        {
          "name": "Get party standing",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/parties/{{buyer}}/standing",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "parties",
                "{{buyer}}",
                "standing"
              ]
            },
            "description": "Strike count, barred flag and reason. Returns a clean default, not 404, for an address with no history."
          }
        }
      ]
    }
