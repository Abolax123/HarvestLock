{
  "info": {
    "name": "HarvestLock API",
    "description": "Every route registered in `api/src/server.ts`, grouped by flow. See `api/postman/README.md` for how to use it and `api/README.md` for full request/response details. Postman never signs anything: build an XDR here, sign it with the party's own key (Freighter or `stellar tx sign`), then paste it into Submit.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health",
      "description": "Liveness.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns `{\"ok\":true,\"checks\":{\"api\":\"ok\",\"database\":\"ok\"}}`, or 503 if the database is down."
          }
        }
      ]
    },
    {
      "name": "Deploy and initialize",
      "description": "Create a fresh escrow instance and initialize it.",
      "item": [
        {
          "name": "Deploy escrow instance",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/commitments/deploy",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "deploy"
              ]
            },
            "description": "Deploys a fresh, uninitialized escrow contract instance. Deployer-paid, no party auth. Needs `ESCROW_WASM_HASH` and `DEPLOYER_SECRET_KEY` on the server. Saves `contractId`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const value = body.contractId;",
                  "if (value) pm.collectionVariables.set(\"contractId\", value);"
                ]
              }
            }
          ]
        },
        {
          "name": "Build initialize XDR",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/commitments/{{contractId}}/tx/initialize",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "commitments",
                "{{contractId}}",
                "tx",
                "initialize"
              ]
            },
            "description": "Builds unsigned `initialize` XDR; the buyer signs it. Window bounds: `claimWindowSecs` 1 h–90 d, `remainderWindowSecs` 1 h–30 d, `deliveryWindowSecs` 1 d–365 d. `oracleConfig` is optional: omit it or pass `null` for a plain deal. Saves `unsignedXdr`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"buyer\": \"{{buyer}}\",\n  \"cooperative\": \"{{cooperative}}\",\n  \"warehouseOperator\": \"{{warehouse}}\",\n  \"token\": \"{{token}}\",\n  \"totalAmount\": \"1000000000\",\n  \"advance1Bps\": 1500,\n  \"advance2Bps\": 2000,\n  \"claimWindowSecs\": \"86400\",\n  \"remainderWindowSecs\": \"604800\",\n  \"deliveryWindowSecs\": \"10368000\",\n  \"contractedQuantity\": 1000,\n  \"gradePriceBps\": [\n    10000\n  ],\n  \"oracleConfig\": null,\n  \"sourcePublicKey\": \"{{buyer}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const body = pm.response.json();",
                  "const value = body.xdr;",
                  "if (value) pm.collectionVariables.set(\"unsignedXdr\", value);"
                ]
              }
            }
          ]
        }
      ]
    },
